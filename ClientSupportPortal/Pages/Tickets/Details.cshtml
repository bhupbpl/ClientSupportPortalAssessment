@page "{id:int}"
@model ClientSupportPortal.Pages.Tickets.DetailsModel
@{
    ViewData["Title"] = "Ticket Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Ticket details</h1>
    <a class="btn btn-outline-secondary" asp-page="./Index">Back to list</a>
</div>

<div class="card">
    <div class="card-header">
        <strong>#@Model.Ticket.Id</strong> @Model.Ticket.Title
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Ticket.Description</dd>

            <dt class="col-sm-3">Requester</dt>
            <dd class="col-sm-9">@Model.Ticket.RequesterName (@Model.Ticket.RequesterEmail)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Ticket.Status</dd>

            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9">@Model.Ticket.Priority</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Ticket.Category</dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.Ticket.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>

            <dt class="col-sm-3">Last Updated</dt>
            <dd class="col-sm-9">@Model.Ticket.LastUpdatedDate.ToString("dd MMM yyyy HH:mm")</dd>

            <dt class="col-sm-3">Assigned To</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Ticket.AssignedTo) ? "Unassigned" : Model.Ticket.AssignedTo)</dd>
        </dl>
    </div>
</div>
