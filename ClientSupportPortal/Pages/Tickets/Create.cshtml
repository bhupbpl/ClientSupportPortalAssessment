@page
@model ClientSupportPortal.Pages.Tickets.CreateModel
@{
    ViewData["Title"] = "Create Ticket";
}

<h1 class="h3 mb-3">Create ticket</h1>

<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="col-md-8">
        <label class="form-label" asp-for="Ticket.Title">Title</label>
        <input class="form-control" asp-for="Ticket.Title" />
        <span asp-validation-for="Ticket.Title" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="Ticket.Category">Category</label>
        <select class="form-select" asp-for="Ticket.Category">
            <option value="">-- Select Category --</option>
            @foreach (var category in Model.CategoryOptions)
            {
                <option value="@category">@category</option>
            }
        </select>
        <span asp-validation-for="Ticket.Category" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label class="form-label" asp-for="Ticket.Description">Description</label>
        <textarea class="form-control" asp-for="Ticket.Description" rows="4"></textarea>
        <span asp-validation-for="Ticket.Description" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="Ticket.RequesterName">Requester name</label>
        <input class="form-control" asp-for="Ticket.RequesterName" />
        <span asp-validation-for="Ticket.RequesterName" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="Ticket.RequesterEmail">Requester email</label>
        <input class="form-control" asp-for="Ticket.RequesterEmail" />
        <span asp-validation-for="Ticket.RequesterEmail" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="Ticket.AssignedTo">Assigned to</label>
        <input class="form-control" asp-for="Ticket.AssignedTo" />
        <span asp-validation-for="Ticket.AssignedTo" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label class="form-label" asp-for="Ticket.Status">Status</label>
        <select class="form-select" asp-for="Ticket.Status" required>
            @foreach (var status in Model.StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>
        <span asp-validation-for="Ticket.Status" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label class="form-label" asp-for="Ticket.Priority">Priority</label>
        <select class="form-select" asp-for="Ticket.Priority" required>
            @foreach (var priority in Model.PriorityOptions)
            {
                <option value="@priority">@priority</option>
            }
        </select>
        <span asp-validation-for="Ticket.Priority" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
