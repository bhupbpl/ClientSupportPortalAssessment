@page
@model ClientSupportPortal.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Tickets</h1>
        <div class="text-muted">@Model.DisplayedCount ticket(s) shown</div>
    </div>
    <a class="btn btn-primary" asp-page="./Create">Create ticket</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label class="form-label" asp-for="SearchTerm">Search</label>
        <input class="form-control" asp-for="SearchTerm" placeholder="Title, description, requester or assignee" />
    </div>
    <div class="col-md-3">
        <label class="form-label" asp-for="StatusFilter">Status</label>
        <select class="form-select" asp-for="StatusFilter">
            <option value="">All statuses</option>
            @foreach (var status in Model.StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="PriorityFilter">Priority</label>
        <select class="form-select" asp-for="PriorityFilter">
            <option value="">All priorities</option>
            @foreach (var priority in Model.PriorityOptions)
            {
                <option value="@priority">@priority</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button class="btn btn-outline-primary" type="submit">Apply</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Title</th>
                <th scope="col">Requester</th>
                <th scope="col">Status</th>
                <th scope="col">Priority</th>
                <th scope="col">Category</th>
                <th scope="col">Created Date</th>
                <th scope="col">Assigned To</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.Tickets)
            {
                <tr>
                    <td>@ticket.Id</td>
                    <td>@ticket.Title</td>
                    <td>
                        <div>@ticket.RequesterName</div>
                        <div class="small text-muted">@ticket.RequesterEmail</div>
                    </td>
                    <td>@ticket.Status</td>
                    <td>@ticket.Priority</td>
                    <td>@ticket.Category</td>
                    <td>@ticket.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td>@(string.IsNullOrWhiteSpace(ticket.AssignedTo) ? "Unassigned" : ticket.AssignedTo)</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="./Details" asp-route-id="@ticket.Id">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@ticket.Id">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
